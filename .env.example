# ─────────────────────────────────────────────────────────────
# baseStarter — environment template
# Copy to .env and adjust. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# HTTP listen address (dev)
PB_HTTP=127.0.0.1:8090

# Data directory (SQLite DB + uploads)
PB_DIR=base/pb_data

# Superuser bootstrap (used by scripts/bootstrap.sh AND scripts/dev.sh)
# dev.sh upserts this account before each start, so the admin always matches .env
# and PocketBase never shows its "create your first superuser" install screen.
# NOTE: domain MUST contain a dot — `admin@local` fails validation, `admin@local.local` works.
PB_SUPERUSER_EMAIL=admin@local.local
# dev-only placeholder — change before any non-local use
PB_SUPERUSER_PASSWORD=supersecretdev

# Optional: 32-char key to encrypt app settings at rest
# PB_ENCRYPTION_KEY=

# Optional: seed a demo user + 3 posts on boot (idempotent). Set to 1 to enable.
# SEED_DEMO=1

# Optional: POST webhook URL fired on posts.create (base/pb_hooks/60_webhooks.pb.js).
# POST_WEBHOOK_URL=
